# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# SerpAPI Configuration
# Get your API key from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_api_key_here

# OpenWeatherMap API Configuration (Optional - for weather tool)
# Get your API key from: https://openweathermap.org/api
# NOTE: After creating your API key, it takes 1-2 hours to activate.
# You may see 401 errors until the key is fully activated.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Application Settings
DEBUG=false
